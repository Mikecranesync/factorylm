{
  "name": "Maintenance Flow - Basic IO and Diagnosis",
  "description": "Tests the core maintenance technician workflows",
  "steps": [
    {
      "user": "/start",
      "expect_contains": ["Welcome", "FactoryLM"],
      "expect_not_contains": ["error"]
    },
    {
      "user": "show me IO",
      "expect_contains": ["Motor", "Conveyor", "Temp"],
      "expect_not_contains": ["error", "failed"]
    },
    {
      "user": "why is this stopped?",
      "expect_contains": ["Diagnosis", "Model"],
      "expect_not_contains": ["error"]
    },
    {
      "user": "/status",
      "expect_contains": ["Matrix API"],
      "expect_not_contains": []
    },
    {
      "user": "what faults are active?",
      "expect_contains": ["Diagnosis"],
      "expect_not_contains": ["error"]
    }
  ]
}
