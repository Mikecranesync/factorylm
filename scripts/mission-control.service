[Unit]
Description=FactoryLM Mission Control Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openclaw/apps/mission-control
ExecStart=/opt/openclaw/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=ANTFARM_DIR=/opt/openclaw/antfarm/workflows

[Install]
WantedBy=multi-user.target
