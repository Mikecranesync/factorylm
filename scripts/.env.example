# FactoryLM Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# PLC Configuration
# ============================================
PLC_TYPE=factoryio_micro820
PLC_HOST=192.168.1.100
PLC_PORT=502
PLC_TIMEOUT=5
PLC_RETRY_COUNT=3

# Factory I/O Scene (for reference)
FACTORY_IO_SCENE=sorting_station

# ============================================
# LLM Configuration (choose one provider)
# ============================================

# Option 1: GROQ (recommended - fast and free tier available)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
# Get your key at: https://console.groq.com/keys

# Option 2: Claude (Anthropic)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# Get your key at: https://console.anthropic.com/

# Option 3: DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_key_here
# Get your key at: https://platform.deepseek.com/

# ============================================
# Optional: Advanced Settings
# ============================================

# LLM Model (provider-specific)
# GROQ_MODEL=mixtral-8x7b-32768
# CLAUDE_MODEL=claude-3-haiku-20240307
# DEEPSEEK_MODEL=deepseek-chat

# Temperature (0.0-1.0, lower = more factual)
# LLM_TEMPERATURE=0.3

# Max tokens for response
# LLM_MAX_TOKENS=500

# ============================================
# Logging
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=factorylm.log
