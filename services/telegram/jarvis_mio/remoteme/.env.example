# RemoteMe Configuration
# Copy to .env and fill in values

DEBUG=false

# Database
DATABASE_URL=sqlite:///./remoteme.db

# Telegram Bot (@JarvisMIO_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
MIKE_TELEGRAM_ID=your_telegram_user_id

# Groq (primary for command parsing - fast & free tier friendly)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic (fallback for command parsing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangFuse (optional - observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Jarvis Nodes (Tailscale IPs)
PLC_LAPTOP_IP=100.72.2.99
PLC_LAPTOP_PORT=8765
TRAVEL_LAPTOP_IP=100.83.251.23
TRAVEL_LAPTOP_PORT=8765

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Directories
UPLOAD_DIR=/opt/remoteme/uploads
RECORDINGS_DIR=/opt/remoteme/recordings
