[Unit]
Description=FactoryLM Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/factorylm/services/telegram
EnvironmentFile=/root/.factorylm/.env
Environment=MATRIX_API=http://100.72.2.99:8000
Environment=DEMO_UI=http://100.72.2.99:8080
Environment=JARVIS_NODE=http://100.72.2.99:8765
ExecStart=/usr/bin/python3 factorylm_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
