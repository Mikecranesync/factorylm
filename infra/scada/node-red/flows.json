    {
        "id": "parse_io",
        "type": "function",
        "z": "tab_scada",
        "name": "Parse PLC I/O",
        "func": "var io = msg.payload;\nif (!io || !io.coils) { node.warn('No PLC data'); return null; }\n\nvar coils = io.coils || {};\nvar inputs = io.inputs || {};\nvar outputs = io.outputs || {};\nvar regs = io.registers || {};\n\n// Coil states\nvar m1 = {payload: coils.Conveyor || false};\nvar m2 = {payload: coils.Emitter || false};\nvar m3 = {payload: coils.SensorStart || false};\nvar m4 = {payload: coils.SensorEnd || false};\nvar m5 = {payload: coils.RunCommand || false};\n\n// E-Stop\nvar estop_no = inputs.DI_01 || false;\nvar estop_nc = inputs.DI_02 !== undefined ? inputs.DI_02 : true;\nvar estop_active = estop_no && !estop_nc;\nvar m6 = {payload: estop_active};\n\n// VFD registers\nvar hz = regs.ConveyorHz || 0;\nvar rpm = Math.round(hz * 30); // 4-pole motor: RPM = Hz * 30\nvar current = (regs.MotorCurrentX10 || 0) / 10.0;\nvar temp = (regs.MotorTempX10 || 0) / 10.0;\nvar vfd_status = regs.VFDStatus || 0;\nvar err_code = regs.ErrorCode || 0;\nvar items = regs.ItemCount || 0;\n\nvar m7 = {payload: hz};          // Hz gauge\nvar m8 = {payload: rpm};         // RPM tachometer\nvar m9 = {payload: current};     // Current gauge\nvar m10 = {payload: temp};       // Temp gauge\nvar m11 = {payload: items};      // Item count\n\n// VFD status text\nvar vfd_map = {0:'Idle', 1:'Running', 2:'FAULT'};\nvar m12 = {payload: vfd_map[vfd_status] || 'Unknown'};\n\n// Error text\nvar err_map = {0:'None', 1:'Overload', 2:'Overheat', 3:'Sensor Fail', 4:'Jam', 7:'E-Stop'};\nvar m13 = {payload: err_code > 0 ? ('ERROR: ' + (err_map[err_code] || err_code)) : 'No Errors'};\n\n// Alarm detection (output 14)\nvar m14 = null;\nif (err_code > 0 || estop_active) {\n    m14 = {payload: {fault: true, error_code: err_code, estop: estop_active, io: io}};\n}\n\n// Item count for trend chart\nvar m15 = {payload: items, topic: 'Items'};\n\nreturn [m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15];",
        "outputs": 15,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 80,
        "wires": [
            ["led_conveyor"],
            ["led_emitter"],
            ["led_sensor_start"],
            ["led_sensor_end"],
            ["led_run_cmd"],
            ["led_estop"],
            ["gauge_hz"],
            ["gauge_rpm"],
            ["gauge_current"],
            ["gauge_temp"],
            ["txt_items"],
            ["txt_vfd_status"],
            ["txt_error"],
            ["alarm_check"],
            ["chart_items"]
        ]
    },

