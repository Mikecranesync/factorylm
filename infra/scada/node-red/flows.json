    {
        "id": "webcam_tach",
        "type": "ui_template",
        "z": "tab_scada",
        "group": "grp_camera",
        "name": "Webcam + Tachometer",
        "order": 1,
        "width": "12",
        "height": "8",
        "format": "<style>\n.cam-container { position: relative; width: 100%; background: #111; border-radius: 8px; overflow: hidden; }\n.cam-feed { width: 100%; height: 340px; object-fit: contain; background: #000; }\n.cam-offline { width: 100%; height: 340px; display: flex; align-items: center; justify-content: center; background: #1a1a2e; color: #666; font-size: 18px; }\n.tach-overlay { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.75); border-radius: 12px; padding: 12px 18px; color: #fff; font-family: monospace; min-width: 140px; }\n.tach-rpm { font-size: 36px; font-weight: bold; color: #00ff88; text-align: center; }\n.tach-label { font-size: 11px; color: #aaa; text-align: center; margin-top: 2px; }\n.tach-hz { font-size: 18px; color: #4fc3f7; text-align: center; margin-top: 6px; }\n.tach-bar { width: 100%; height: 6px; background: #333; border-radius: 3px; margin-top: 8px; overflow: hidden; }\n.tach-fill { height: 100%; border-radius: 3px; transition: width 0.3s, background 0.3s; }\n.status-badge { position: absolute; top: 12px; left: 12px; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; font-family: monospace; }\n.status-run { background: #00c853; color: #000; }\n.status-stop { background: #666; color: #fff; }\n.status-fault { background: #ff1744; color: #fff; animation: blink 0.5s infinite; }\n@keyframes blink { 50% { opacity: 0.4; } }\n</style>\n\n<div class=\"cam-container\">\n  <img class=\"cam-feed\" id=\"webcam-feed\" src=\"\" onerror=\"this.style.display='none'; document.getElementById('cam-off').style.display='flex';\" onload=\"this.style.display='block'; document.getElementById('cam-off').style.display='none';\" />\n  <div class=\"cam-offline\" id=\"cam-off\">CAMERA OFFLINE — Set WEBCAM_URL env var</div>\n  \n  <div class=\"status-badge\" id=\"status-badge\">IDLE</div>\n  \n  <div class=\"tach-overlay\">\n    <div class=\"tach-rpm\" id=\"tach-rpm\">0</div>\n    <div class=\"tach-label\">RPM</div>\n    <div class=\"tach-hz\" id=\"tach-hz\">0 Hz</div>\n    <div class=\"tach-bar\"><div class=\"tach-fill\" id=\"tach-fill\" style=\"width:0%;background:#00ff88;\"></div></div>\n  </div>\n</div>\n\n<script>\n(function() {\n    var scope = this.scope;\n    var webcamUrl = '';\n    \n    // Try to get webcam URL from global context\n    try { webcamUrl = RED.settings.functionGlobalContext.WEBCAM_URL || ''; } catch(e) {}\n    if (!webcamUrl) { webcamUrl = 'http://100.72.2.99:8081/stream'; }\n    \n    var feed = document.getElementById('webcam-feed');\n    if (feed && webcamUrl) { feed.src = webcamUrl; }\n    \n    scope.$watch('msg', function(msg) {\n        if (!msg || !msg.payload) return;\n        var io = msg.payload;\n        if (!io.registers) return;\n        \n        var hz = io.registers.ConveyorHz || 0;\n        var rpm = Math.round(hz * 30);\n        var pct = Math.min(100, (hz / 60) * 100);\n        var err = io.registers.ErrorCode || 0;\n        var vfd = io.registers.VFDStatus || 0;\n        \n        var rpmEl = document.getElementById('tach-rpm');\n        var hzEl = document.getElementById('tach-hz');\n        var fillEl = document.getElementById('tach-fill');\n        var badge = document.getElementById('status-badge');\n        \n        if (rpmEl) rpmEl.textContent = rpm;\n        if (hzEl) hzEl.textContent = hz + ' Hz';\n        if (fillEl) {\n            fillEl.style.width = pct + '%';\n            fillEl.style.background = pct > 83 ? '#ff1744' : pct > 50 ? '#ffab00' : '#00ff88';\n        }\n        if (badge) {\n            if (err > 0 || vfd === 2) {\n                badge.className = 'status-badge status-fault';\n                badge.textContent = 'FAULT';\n            } else if (vfd === 1) {\n                badge.className = 'status-badge status-run';\n                badge.textContent = 'RUNNING';\n            } else {\n                badge.className = 'status-badge status-stop';\n                badge.textContent = 'IDLE';\n            }\n        }\n    });\n})();\n</script>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 710,
        "y": 480,
        "wires": [[]]
    },

