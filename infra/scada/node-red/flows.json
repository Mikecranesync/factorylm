    {
        "id": "alarm_format",
        "type": "function",
        "z": "tab_scada",
        "name": "Format alarm query",
        "func": "var f = msg.payload;\nvar err_map = {0:'None', 1:'Overload', 2:'Overheat', 3:'Sensor Fail', 4:'Jam', 7:'E-Stop'};\nvar desc = err_map[f.error_code] || ('Code ' + f.error_code);\n\n// Rate limit: only send once per 10 seconds\nvar last = flow.get('last_alarm_ts') || 0;\nvar now = Date.now();\nif (now - last < 10000) return null;\nflow.set('last_alarm_ts', now);\n\n// Log to alarm panel\nvar log = flow.get('alarm_log') || [];\nvar entry = new Date().toLocaleTimeString() + ' — ' + desc;\nif (f.estop) entry += ' + E-STOP ACTIVE';\nlog.unshift(entry);\nif (log.length > 20) log.pop();\nflow.set('alarm_log', log);\n\nvar m1 = {payload: log.join('\\n')};\nvar m2 = {payload: JSON.stringify({question: 'ALARM: ' + desc + '. E-Stop: ' + (f.estop ? 'YES' : 'NO') + '. What is wrong and what should the operator do?'}), headers: {'content-type': 'application/json'}};\n\nreturn [m1, m2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 510,
        "wires": [["alarm_display"], ["http_diagnose"]]
    },
