# FactoryLM Configuration
# Copy this file to .env and fill in your values

# LLM Provider Configuration
# Options: groq, deepseek, claude, flm
LLM_PROVIDER=groq

# API Key for the selected provider
# GROQ: Get from https://console.groq.com/keys
# DeepSeek: Get from https://platform.deepseek.com/
# Claude: Get from https://console.anthropic.com/
LLM_API_KEY=your-api-key-here

# Model to use (optional - defaults vary by provider)
# GROQ default: mixtral-8x7b-32768
# DeepSeek default: deepseek-chat
# Claude default: claude-3-sonnet-20240229
LLM_MODEL=

# Logging Configuration
LOG_LEVEL=INFO

# Development Settings
DEBUG=false
